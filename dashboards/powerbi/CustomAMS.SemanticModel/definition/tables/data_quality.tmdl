	partition data_quality = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "data_quality.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Headers = Table.SelectColumns(Promoted, {"date", "athletes_on_roster", "forms_expected", "forms_received", "ratings_expected", "ratings_received", "device_failure_rows", "form_completion_pct", "rating_completion_pct", "last_ok_import", "forms_label"}),
				    NoEmpty = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, {"date", "athletes_on_roster", "forms_expected", "forms_received", "ratings_expected", "ratings_received", "device_failure_rows", "form_completion_pct", "rating_completion_pct"}),
				    NoNA = Table.ReplaceValue(NoEmpty, "NA", null, Replacer.ReplaceValue, {"date", "athletes_on_roster", "forms_expected", "forms_received", "ratings_expected", "ratings_received", "device_failure_rows", "form_completion_pct", "rating_completion_pct"}),
				    Typed = Table.TransformColumnTypes(NoNA, {{"date", type date}, {"athletes_on_roster", Int64.Type}, {"forms_expected", Int64.Type}, {"forms_received", Int64.Type}, {"ratings_expected", Int64.Type}, {"ratings_received", Int64.Type}, {"device_failure_rows", Int64.Type}, {"form_completion_pct", type number}, {"rating_completion_pct", type number}, {"last_ok_import", type text}, {"forms_label", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
