table data_quality
	lineageTag: ecb70f2d-3bdc-5004-89cf-1254ffc2e0c9

	measure 'Forms received' =
			VAR d = [As of date]
			RETURN
			    CALCULATE ( SELECTEDVALUE ( data_quality[forms_label] ), REMOVEFILTERS ( dates ), data_quality[date] = d )
		lineageTag: 1afd3ef3-ef7c-5236-ad20-567d98cfeeb5

	measure 'Last successful import' =
			VAR d = [As of date]
			RETURN
			    CALCULATE ( SELECTEDVALUE ( data_quality[last_ok_import] ), REMOVEFILTERS ( dates ), data_quality[date] = d )
		lineageTag: 0f235694-4006-58c3-b414-08286a2a24e2

	measure 'Form completion (%)' = SELECTEDVALUE ( data_quality[form_completion_pct] )
		formatString: 0
		lineageTag: 9927a4a8-84e6-55be-b0c6-0171a0277fa2

	measure 'Rating completion (%)' = SELECTEDVALUE ( data_quality[rating_completion_pct] )
		formatString: 0
		lineageTag: 44367c7a-6c01-5322-8b99-510470529c0d

	measure 'Device failure rows' = SELECTEDVALUE ( data_quality[device_failure_rows] )
		formatString: 0
		lineageTag: fb5a36ea-8dc5-50d7-a4b1-7b15d90b9e14

