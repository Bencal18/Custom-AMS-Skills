table test_day_summary
	lineageTag: ac6770c6-e6dc-5d27-96f7-e8b936fd7911

	measure 'Jump flags, last test day' =
			VAR d = [As of date]
			VAR t = CALCULATE ( MAX ( test_day_summary[date] ), REMOVEFILTERS ( dates ), test_day_summary[date] <= d )
			RETURN
			    IF (
			        NOT ISBLANK ( t ),
			        CALCULATE ( SELECTEDVALUE ( test_day_summary[summary_label] ), REMOVEFILTERS ( dates ), test_day_summary[date] = t ) & " (" & FORMAT ( t, "yyyy-mm-dd" ) & ")"
			    )
		lineageTag: 5c0866a2-5c45-500b-815f-c5fe84f753fc

	measure 'Jump flags, test day shown' =
			VAR t = [Test day shown]
			RETURN
			    CALCULATE ( SELECTEDVALUE ( test_day_summary[summary_label] ), REMOVEFILTERS ( dates ), test_day_summary[date] = t )
		lineageTag: 6be1ae85-e24a-55d7-b59b-1851cc64f4bd

	column date
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 3b0542ce-61ff-50c3-9291-f1987b7c81b8
		summarizeBy: none
		sourceColumn: date

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

