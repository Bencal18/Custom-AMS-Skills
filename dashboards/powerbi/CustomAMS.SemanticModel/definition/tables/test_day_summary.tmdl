		annotation SummarizationSetBy = User

	partition test_day_summary = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "test_day_summary.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Headers = Table.SelectColumns(Promoted, {"date", "chosen_direction", "results", "flagged", "beyond_band", "beyond_band_other_direction", "no_data", "beyond_band_expected_by_chance", "summary_label"}),
				    NoEmpty = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, {"date", "results", "flagged", "beyond_band", "beyond_band_other_direction", "no_data", "beyond_band_expected_by_chance"}),
				    NoNA = Table.ReplaceValue(NoEmpty, "NA", null, Replacer.ReplaceValue, {"date", "results", "flagged", "beyond_band", "beyond_band_other_direction", "no_data", "beyond_band_expected_by_chance"}),
				    Typed = Table.TransformColumnTypes(NoNA, {{"date", type date}, {"chosen_direction", type text}, {"results", Int64.Type}, {"flagged", Int64.Type}, {"beyond_band", Int64.Type}, {"beyond_band_other_direction", Int64.Type}, {"no_data", Int64.Type}, {"beyond_band_expected_by_chance", type number}, {"summary_label", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
