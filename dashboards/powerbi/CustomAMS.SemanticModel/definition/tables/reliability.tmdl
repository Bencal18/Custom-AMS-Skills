	partition reliability = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "reliability.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Headers = Table.SelectColumns(Promoted, {"measure_name", "unit", "trial_summary", "te", "te_df", "multiplier", "swc", "te_athletes", "te_source", "swc_source"}),
				    NoEmpty = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, {"te", "te_df", "multiplier", "swc", "te_athletes"}),
				    NoNA = Table.ReplaceValue(NoEmpty, "NA", null, Replacer.ReplaceValue, {"te", "te_df", "multiplier", "swc", "te_athletes"}),
				    Typed = Table.TransformColumnTypes(NoNA, {{"measure_name", type text}, {"unit", type text}, {"trial_summary", type text}, {"te", type number}, {"te_df", Int64.Type}, {"multiplier", type number}, {"swc", type number}, {"te_athletes", Int64.Type}, {"te_source", type text}, {"swc_source", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
