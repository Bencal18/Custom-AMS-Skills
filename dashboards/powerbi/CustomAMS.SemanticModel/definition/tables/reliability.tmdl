table reliability
	lineageTag: 61db5b2f-9361-5dd8-a6c4-4fdd82030c4b

	measure 'Typical error label' =
			VAR r = SELECTEDVALUE ( reliability[te_source] )
			RETURN
			    "Typical error " & FORMAT ( SELECTEDVALUE ( reliability[te] ), "0.00" ) & " cm. Smallest worthwhile change " & FORMAT ( SELECTEDVALUE ( reliability[swc] ), "0.00" ) & " cm. " & r
		lineageTag: 5ed9606a-1b9b-5245-93d0-b872819b3ad3

