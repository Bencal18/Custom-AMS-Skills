table import_log
	lineageTag: fb138c66-ec5d-5f5e-b0d9-39449d08ae88

	column import_id
		dataType: string
		lineageTag: 7cacd4b7-7b9c-5d49-9f37-042fc00e6f34
		summarizeBy: none
		sourceColumn: import_id

		annotation SummarizationSetBy = User

	column source
		dataType: string
		lineageTag: 8a4fa6df-0927-52af-a94a-843e293cb1dd
		summarizeBy: none
		sourceColumn: source

		annotation SummarizationSetBy = User

	column import_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 3a476cbd-170e-5f25-9be9-d486e0c30cc9
		summarizeBy: none
		sourceColumn: import_date

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	column import_time_local
		dataType: string
		lineageTag: cd0ad26f-4fc1-5e73-928a-3281c849ca70
		summarizeBy: none
		sourceColumn: import_time_local

