		summarizeBy: none
		sourceColumn: result

		annotation SummarizationSetBy = User

	partition import_log = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "import_log.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Headers = Table.SelectColumns(Promoted, {"import_id", "source", "import_date", "import_time_local", "rows_imported", "result"}),
				    NoEmpty = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, {"import_date", "rows_imported"}),
				    NoNA = Table.ReplaceValue(NoEmpty, "NA", null, Replacer.ReplaceValue, {"import_date", "rows_imported"}),
				    Typed = Table.TransformColumnTypes(NoNA, {{"import_id", type text}, {"source", type text}, {"import_date", type date}, {"import_time_local", type text}, {"rows_imported", Int64.Type}, {"result", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
