	partition test_results = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "test_results.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Headers = Table.SelectColumns(Promoted, {"athlete_id", "date", "trials_attempted", "value", "trials_ok", "measure_name", "baseline_mean", "baseline_n", "change", "te", "multiplier", "noise_band", "swc", "band_low_cm", "band_high_cm", "direction", "state", "wording", "change_low", "change_high", "change_vs_band", "change_vs_band_chosen", "athlete_sentence", "chosen_direction"}),
				    NoEmpty = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, {"date", "trials_attempted", "value", "trials_ok", "baseline_mean", "baseline_n", "change", "te", "multiplier", "noise_band", "swc", "band_low_cm", "band_high_cm", "change_low", "change_high", "change_vs_band", "change_vs_band_chosen"}),
				    NoNA = Table.ReplaceValue(NoEmpty, "NA", null, Replacer.ReplaceValue, {"date", "trials_attempted", "value", "trials_ok", "baseline_mean", "baseline_n", "change", "te", "multiplier", "noise_band", "swc", "band_low_cm", "band_high_cm", "change_low", "change_high", "change_vs_band", "change_vs_band_chosen"}),
				    Typed = Table.TransformColumnTypes(NoNA, {{"athlete_id", type text}, {"date", type date}, {"trials_attempted", Int64.Type}, {"value", type number}, {"trials_ok", Int64.Type}, {"measure_name", type text}, {"baseline_mean", type number}, {"baseline_n", Int64.Type}, {"change", type number}, {"te", type number}, {"multiplier", type number}, {"noise_band", type number}, {"swc", type number}, {"band_low_cm", type number}, {"band_high_cm", type number}, {"direction", type text}, {"state", type text}, {"wording", type text}, {"change_low", type number}, {"change_high", type number}, {"change_vs_band", type number}, {"change_vs_band_chosen", type number}, {"athlete_sentence", type text}, {"chosen_direction", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
