table test_results
	lineageTag: ca31e7e4-8fa8-5d1e-9ccb-3b76ae1d8778

	measure 'Test day shown' =
			VAR picked = CALCULATE ( SELECTEDVALUE ( test_results[date] ), REMOVEFILTERS ( athletes ) )
			RETURN
			    IF ( ISBLANK ( picked ), CALCULATE ( MAX ( test_results[date] ), REMOVEFILTERS () ), picked )
		formatString: yyyy-mm-dd
		lineageTag: 65c98343-ce9f-56e4-8ee5-d736acf66693

	measure 'Jump on test day (cm)' =
			VAR t = [Test day shown]
			RETURN
			    CALCULATE ( SELECTEDVALUE ( test_results[value] ), REMOVEFILTERS ( test_results[date] ), REMOVEFILTERS ( dates ), test_results[date] = t )
		formatString: 0.0
		lineageTag: ca4d723f-0cf2-5379-bc64-bbc7b691f611

	measure 'Baseline mean (cm)' =
			VAR t = [Test day shown]
			RETURN
			    CALCULATE ( SELECTEDVALUE ( test_results[baseline_mean] ), REMOVEFILTERS ( test_results[date] ), REMOVEFILTERS ( dates ), test_results[date] = t )
		formatString: 0.0
		lineageTag: 1294af18-372e-571d-8911-68b18abdde82

	measure 'Baseline tests' =
			VAR t = [Test day shown]
			RETURN
			    CALCULATE ( SELECTEDVALUE ( test_results[baseline_n] ), REMOVEFILTERS ( test_results[date] ), REMOVEFILTERS ( dates ), test_results[date] = t )
		formatString: 0
		lineageTag: 1b2ae830-dc44-5ee2-9e79-6cab3733b3a6

	measure 'Change on test day (cm)' =
			VAR t = [Test day shown]
			RETURN
			    CALCULATE ( SELECTEDVALUE ( test_results[change] ), REMOVEFILTERS ( test_results[date] ), REMOVEFILTERS ( dates ), test_results[date] = t )
		formatString: +0.0;-0.0;0.0
		lineageTag: 439debdc-663e-5f64-87e3-2e5998f6daf6

	measure 'Noise band on test day (cm)' =
			VAR t = [Test day shown]
			RETURN
			    CALCULATE ( SELECTEDVALUE ( test_results[noise_band] ), REMOVEFILTERS ( test_results[date] ), REMOVEFILTERS ( dates ), test_results[date] = t )
		formatString: 0.0
		lineageTag: 5b1e8843-1150-50a5-adfd-1f649afc2682

	measure 'State on test day' =
			VAR t = [Test day shown]
			RETURN
			    CALCULATE ( SELECTEDVALUE ( test_results[wording] ), REMOVEFILTERS ( test_results[date] ), REMOVEFILTERS ( dates ), test_results[date] = t )
		lineageTag: 1a3e63b5-f063-5c97-9ea9-9d30a08de3ae

	measure 'Change vs band on test day, chosen direction' =
			VAR t = [Test day shown]
			RETURN
			    CALCULATE ( SELECTEDVALUE ( test_results[change_vs_band_chosen] ), REMOVEFILTERS ( test_results[date] ), REMOVEFILTERS ( dates ), test_results[date] = t )
		formatString: 0.00
		lineageTag: c9414d52-fbaf-587f-9679-369e72b2be9a

	measure 'Jump height, one athlete (cm)' = IF ( HASONEVALUE ( athletes[athlete_id] ), SELECTEDVALUE ( test_results[value] ) )
		formatString: 0.0
		lineageTag: f5bfce7f-e837-5867-adc4-2fecb7b2c4ba

	measure 'Band low, one athlete (cm)' = IF ( HASONEVALUE ( athletes[athlete_id] ), SELECTEDVALUE ( test_results[band_low_cm] ) )
		formatString: 0.0
		lineageTag: ac28a7eb-daa3-5362-8e95-a8b7a67b218e

	measure 'Band high, one athlete (cm)' = IF ( HASONEVALUE ( athletes[athlete_id] ), SELECTEDVALUE ( test_results[band_high_cm] ) )
		formatString: 0.0
		lineageTag: e1b508fa-2267-53ee-9d5e-b26ba175e682

	measure 'Latest jump sentence' =
			IF (
			    HASONEVALUE ( athletes[athlete_id] ),
			    VAR t = CALCULATE ( MAX ( test_results[date] ), REMOVEFILTERS ( dates ), REMOVEFILTERS ( test_results[date] ) )
			    RETURN
			        CALCULATE ( SELECTEDVALUE ( test_results[athlete_sentence] ), REMOVEFILTERS ( dates ), test_results[date] = t )
			)
		lineageTag: e0fd18f6-43af-53a2-b813-2a56a24f1afa

