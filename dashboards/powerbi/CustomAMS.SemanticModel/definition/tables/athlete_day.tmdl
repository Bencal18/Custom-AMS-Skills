table athlete_day
	lineageTag: 5032d6ee-3167-5e9a-8f14-1651856468ac

	measure 'As of date' =
			IF (
			    HASONEVALUE ( dates[date] ),
			    VALUES ( dates[date] ),
			    CALCULATE ( MAX ( athlete_day[date] ), REMOVEFILTERS () )
			)
		formatString: yyyy-mm-dd
		lineageTag: 5ec7f789-bcb7-5134-833f-d97a77827eff

	measure 'As of label' = "As of " & FORMAT ( [As of date], "yyyy-mm-dd" )
		lineageTag: 8cb14d43-9bda-5832-a39e-1e8fccafbf54

	measure 'Availability status' =
			VAR d = [As of date]
			RETURN
			    CALCULATE ( SELECTEDVALUE ( athlete_day[availability] ), REMOVEFILTERS ( dates ), athlete_day[date] = d )
		lineageTag: 2bfe7114-1f40-5566-bfe0-231d364bb5ae

	measure 'Form submitted' =
			VAR d = [As of date]
			RETURN
			    CALCULATE ( SELECTEDVALUE ( athlete_day[form_submitted] ), REMOVEFILTERS ( dates ), athlete_day[date] = d )
		lineageTag: c8d7f109-0a96-5e82-8292-9273d407563d

	measure 'Wellness total (points)' =
			VAR d = [As of date]
			RETURN
			    CALCULATE ( SELECTEDVALUE ( athlete_day[wellness_total] ), REMOVEFILTERS ( dates ), athlete_day[date] = d )
		formatString: 0
		lineageTag: 622e88d0-1786-5115-9096-96e3044f2113

	measure 'Wellness change (points)' =
			VAR d = [As of date]
			RETURN
			    CALCULATE ( SELECTEDVALUE ( athlete_day[wellness_change_points] ), REMOVEFILTERS ( dates ), athlete_day[date] = d )
		formatString: +0.0;-0.0;0.0
		lineageTag: 6e45e5bf-583c-5032-b0aa-8ebd02eaf70a

	measure 'Wellness z' =
			VAR d = [As of date]
			RETURN
			    CALCULATE ( SELECTEDVALUE ( athlete_day[wellness_total_z] ), REMOVEFILTERS ( dates ), athlete_day[date] = d )
		formatString: +0.00;-0.00;0.00
		lineageTag: 6d34a2c1-cbc3-52c6-8419-31a702122b9f

	measure 'Wellness status' =
			VAR d = [As of date]
			RETURN
			    CALCULATE ( SELECTEDVALUE ( athlete_day[wellness_status] ), REMOVEFILTERS ( dates ), athlete_day[date] = d )
		lineageTag: db82127b-c3dd-5218-ab87-f0cdf25b76fa

	measure 'Wellness review' =
			VAR d = [As of date]
			RETURN
			    CALCULATE ( SELECTEDVALUE ( athlete_day[wellness_review] ), REMOVEFILTERS ( dates ), athlete_day[date] = d )
		lineageTag: 91e384e4-4c0e-5037-b02e-70943f4387a8

	measure 'Acute load (AU)' =
			VAR d = [As of date]
			RETURN
			    CALCULATE ( SELECTEDVALUE ( athlete_day[acute_load_au] ), REMOVEFILTERS ( dates ), athlete_day[date] = d )
		formatString: #,0.00
		lineageTag: 4f044155-357c-5176-af74-333d4f591cfa

	measure 'Chronic load (AU)' =
			VAR d = [As of date]
			RETURN
			    CALCULATE ( SELECTEDVALUE ( athlete_day[chronic_load_au] ), REMOVEFILTERS ( dates ), athlete_day[date] = d )
		formatString: #,0.00
		lineageTag: bb328e39-859d-53a5-bacb-f7ebe6082d6f

	measure 'ACWR, rolling coupled 7:28' =
			VAR d = [As of date]
			RETURN
			    CALCULATE ( SELECTEDVALUE ( athlete_day[acwr_coupled] ), REMOVEFILTERS ( dates ), athlete_day[date] = d )
		formatString: 0.00
