	measure 'Last jump date' =
			VAR d = [As of date]
			RETURN
			    CALCULATE ( SELECTEDVALUE ( athlete_day[cmj_date] ), REMOVEFILTERS ( dates ), athlete_day[date] = d )
		formatString: yyyy-mm-dd
		lineageTag: 2574b3a2-c43d-547d-b8fd-05116223cdcb

	measure 'Last jump (cm)' =
			VAR d = [As of date]
			RETURN
			    CALCULATE ( SELECTEDVALUE ( athlete_day[cmj_cm] ), REMOVEFILTERS ( dates ), athlete_day[date] = d )
		formatString: 0.0
		lineageTag: 066ef90a-1f73-5f6d-9dc3-1183fdca47ae

	measure 'Jump change (cm)' =
			VAR d = [As of date]
			RETURN
			    CALCULATE ( SELECTEDVALUE ( athlete_day[cmj_change_cm] ), REMOVEFILTERS ( dates ), athlete_day[date] = d )
		formatString: +0.0;-0.0;0.0
		lineageTag: 0939606b-2dd1-5fcb-951a-fe7937d56db7

	measure 'Jump noise band (cm)' =
			VAR d = [As of date]
			RETURN
			    CALCULATE ( SELECTEDVALUE ( athlete_day[cmj_noise_band_cm] ), REMOVEFILTERS ( dates ), athlete_day[date] = d )
		formatString: 0.0
		lineageTag: be7c78eb-c056-5157-933e-21b25b63b6c6

	measure 'Jump state' =
			VAR d = [As of date]
			RETURN
			    CALCULATE ( SELECTEDVALUE ( athlete_day[cmj_wording] ), REMOVEFILTERS ( dates ), athlete_day[date] = d )
		lineageTag: ebe1e76a-7eda-540c-ad88-fc2a4c19777c

	measure 'Jump change vs band' =
			VAR d = [As of date]
			RETURN
			    CALCULATE ( SELECTEDVALUE ( athlete_day[cmj_change_vs_band] ), REMOVEFILTERS ( dates ), athlete_day[date] = d )
		formatString: 0.00
		lineageTag: a53857db-2b16-53d1-8e3e-22ff4bd17f20

	measure 'Athletes full' =
			VAR d = [As of date]
			RETURN
			    CALCULATE ( COUNTROWS ( athlete_day ), REMOVEFILTERS ( dates ), REMOVEFILTERS ( athletes ), athlete_day[date] = d, athlete_day[availability] = "full" ) + 0
		formatString: 0
		lineageTag: d2af82ed-d586-5b82-8b92-bac28a0d198c

	measure 'Athletes modified' =
			VAR d = [As of date]
			RETURN
			    CALCULATE ( COUNTROWS ( athlete_day ), REMOVEFILTERS ( dates ), REMOVEFILTERS ( athletes ), athlete_day[date] = d, athlete_day[availability] = "modified" ) + 0
		formatString: 0
		lineageTag: 98a9ff51-53c8-514d-a90c-e80676aecfde

	measure 'Athletes out' =
			VAR d = [As of date]
			RETURN
			    CALCULATE ( COUNTROWS ( athlete_day ), REMOVEFILTERS ( dates ), REMOVEFILTERS ( athletes ), athlete_day[date] = d, athlete_day[availability] = "out" ) + 0
		formatString: 0
		lineageTag: 7cacf702-0175-51af-9d51-c826e99777d2

	measure 'Availability summary' = [Athletes full] & " full, " & [Athletes modified] & " modified, " & [Athletes out] & " out"
		lineageTag: 09029715-89cd-5472-aa8a-9c33dbd3a2ad

	measure 'Daily load (AU)' = IF ( HASONEVALUE ( athletes[athlete_id] ), SELECTEDVALUE ( athlete_day[srpe_load_au] ) )
		formatString: #,0
		lineageTag: ac1fcbe2-3ff5-514e-83a9-f9b2bbaa497c

	measure 'Acute load, one athlete (AU)' = IF ( HASONEVALUE ( athletes[athlete_id] ), SELECTEDVALUE ( athlete_day[acute_load_au] ) )
		formatString: #,0.00
		lineageTag: 9da63c1d-f866-59ed-a200-d38f8046e4ec

	measure 'Chronic load, one athlete (AU)' = IF ( HASONEVALUE ( athletes[athlete_id] ), SELECTEDVALUE ( athlete_day[chronic_load_au] ) )
		formatString: #,0.00
		lineageTag: 12ae715c-eb09-542d-8af6-a9b0f6fa114f

	measure 'Wellness total, one athlete (points)' = IF ( HASONEVALUE ( athletes[athlete_id] ), SELECTEDVALUE ( athlete_day[wellness_total] ) )
		formatString: 0
		lineageTag: 0b59c05c-3b33-543e-9e14-1b3de781f3ad

	measure 'Wellness z by day' = SELECTEDVALUE ( athlete_day[wellness_total_z] )
		formatString: +0.0;-0.0;0.0
		lineageTag: a5978906-c628-5fa8-bab3-ba85cb52dcb7

	measure 'Athletes full by day' = CALCULATE ( COUNTROWS ( athlete_day ), athlete_day[availability] = "full" ) + 0
		formatString: 0
		lineageTag: ea527c0b-9503-5b1b-bcf9-e6c4ca61b390

	measure 'Athletes modified by day' = CALCULATE ( COUNTROWS ( athlete_day ), athlete_day[availability] = "modified" ) + 0
		formatString: 0
		lineageTag: d39106b3-9a81-5a12-a4fb-3bd913db073c

	measure 'Athletes out by day' = CALCULATE ( COUNTROWS ( athlete_day ), athlete_day[availability] = "out" ) + 0
		formatString: 0
		lineageTag: 9114086f-0b13-59f3-8115-9fe8b01b480e

