  <dashboards>
    <dashboard name="Squad board">
      <style />
      <size maxheight='900' maxwidth='1400' minheight='900' minwidth='1400' />
      <zones>
        <zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h="8000" id="3" type-v2='text' w='100000' x='0' y="0">
            <formatted-text>
              <run>Squad board for the latest day. Staff only. Jump state compares the latest test with the athlete's baseline and the noise band.
ACWR describes how recent load compares with longer-term load. It does not predict injury.</run>
            </formatted-text>
          </zone>
          <zone h="92000" id="4" name="Squad board table" w='100000' x='0' y="8000" />
        </zone>
      </zones>
      <simple-id uuid="{B9F6B30C-2DE1-55AB-ABCE-EE59142F4B3D}" />
    </dashboard>
    <dashboard name="Athlete profile">
      <style />
      <size maxheight='900' maxwidth='1400' minheight='900' minwidth='1400' />
      <zones>
        <zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h="8000" id="3" type-v2='text' w='100000' x='0' y="0">
            <formatted-text>
              <run>Pick one athlete. Every chart compares the athlete with their own data.</run>
            </formatted-text>
          </zone>
          <zone h="8000" id="4" mode='compact' param='[Parameters].[athlete_choice]' type-v2='paramctrl' w='100000' x='0' y="8000" />
          <zone h="28000" id="5" name="Profile load" w='100000' x='0' y="16000" />
          <zone h="28000" id="6" name="Profile jump" w='100000' x='0' y="44000" />
          <zone h="28000" id="7" name="Profile wellness" w='100000' x='0' y="72000" />
        </zone>
      </zones>
      <simple-id uuid="{1DE4772C-40BF-5989-8440-F4A771F5385A}" />
    </dashboard>
    <dashboard name="Load">
      <style />
      <size maxheight='900' maxwidth='1400' minheight='900' minwidth='1400' />
      <zones>
        <zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h="8000" id="3" type-v2='text' w='100000' x='0' y="0">
            <formatted-text>
