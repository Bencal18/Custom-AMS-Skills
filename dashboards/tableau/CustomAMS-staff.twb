    <worksheet name="Jump changes">
      <table>
        <view>
          <datasources>
            <datasource caption="test_results" name="federated.test_results" />
          </datasources>
          <datasource-dependencies datasource="federated.test_results">
            <column datatype="string" name="[name]" role="dimension" type="nominal" />
            <column datatype="real" name="[change]" role="measure" type="quantitative" />
            <column datatype="string" name="[wording]" role="dimension" type="nominal" />
            <column caption="Latest test day" datatype="boolean" name="[latest_test_day]" role="dimension" type="nominal">
              <calculation class='tableau' formula="[date] = {FIXED : MAX([date])}" />
            </column>
            <column datatype="real" name="[change_vs_band_chosen]" role="measure" type="quantitative" />
            <column datatype="date" name="[date]" role="dimension" type="ordinal" />
            <column-instance column="[name]" derivation="None" name="[none:name:nk]" pivot='key' type="nominal" />
            <column-instance column="[change]" derivation="Avg" name="[avg:change:qk]" pivot='key' type="quantitative" />
            <column-instance column="[wording]" derivation="None" name="[none:wording:nk]" pivot='key' type="nominal" />
            <column-instance column="[latest_test_day]" derivation="None" name="[none:latest_test_day:nk]" pivot='key' type="nominal" />
            <column-instance column="[change_vs_band_chosen]" derivation="Avg" name="[avg:change_vs_band_chosen:qk]" pivot='key' type="quantitative" />
          </datasource-dependencies>
          <filter class='categorical' column="[federated.test_results].[none:latest_test_day:nk]">
            <groupfilter function='member' level="[none:latest_test_day:nk]" member="true" user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <computed-sort column="[federated.test_results].[none:name:nk]" direction="DESC" using="[federated.test_results].[avg:change_vs_band_chosen:qk]" />
          <slices>
            <column>[federated.test_results].[none:latest_test_day:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class="Bar" />
              <encodings>
                <color column="[federated.test_results].[none:wording:nk]" />
              </encodings>
          </pane>
        </panes>
        <rows>[federated.test_results].[none:name:nk]</rows>
        <cols>[federated.test_results].[avg:change:qk]</cols>
      </table>
      <simple-id uuid="{50739110-E6D2-5A2C-9C52-288D5560E8EC}" />
    </worksheet>
    <worksheet name="Weekly load">
      <table>
        <view>
          <datasources>
            <datasource caption="weekly_load" name="federated.weekly_load" />
          </datasources>
          <datasource-dependencies datasource="federated.weekly_load">
            <column datatype="string" name="[name]" role="dimension" type="nominal" />
